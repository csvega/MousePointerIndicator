<Window x:Class="MousePointerIndicator.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="180"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">

    <Grid>

        <Grid x:Name="UpLayout">

            <Canvas>

                <Polygon
                Fill="Red"
                Points="90,10 82,28 98,28"/>

                <Rectangle
                Width="4"
                Height="45"
                Fill="Red"
                Canvas.Left="88"
                Canvas.Top="25"/>

                <Border
                Canvas.Left="52"
                Canvas.Top="78"
                Background="#DDFFFFFF"
                CornerRadius="8"
                Padding="8">

                    <TextBlock
                    Text="Click"
                    FontWeight="Bold"
                    FontSize="22"
                    Foreground="Red"/>

                </Border>

            </Canvas>

        </Grid>

        <Grid x:Name="DownLayout"
          Visibility="Collapsed">

            <Canvas>

                <Border
                Canvas.Left="52"
                Canvas.Top="10"
                Background="#DDFFFFFF"
                CornerRadius="8"
                Padding="8">

                    <TextBlock
                    Text="Click"
                    FontWeight="Bold"
                    FontSize="22"
                    Foreground="Red"/>

                </Border>

                <Rectangle
                Width="4"
                Height="45"
                Fill="Red"
                Canvas.Left="88"
                Canvas.Top="55"/>

                <Polygon
                Fill="Red"
                Points="82,100 98,100 90,118"/>

            </Canvas>

        </Grid>

    </Grid>

</Window>